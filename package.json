{
  "name": "litmus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Litmus \u2014 one reading of your tasks, classes, assignments and habits (Cloudflare + Supabase PWA)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vapid": "node scripts/generate-vapid.mjs",
    "deploy": "vite build && wrangler deploy",
    "cf:dev": "vite build && wrangler dev",
    "verify:push": "node verify-push.mjs",
    "verify:imports": "eslint --no-eslintrc --parser-options=ecmaVersion:2022,sourceType:module,ecmaFeatures:{jsx:true} --env browser,es2022 --rule \"{ \\\"no-undef\\\": [\\\"error\\\"] }\" \"src/**/*.js\" \"src/**/*.jsx\" \"worker/*.js\"",
    "verify:store": "node scripts/verify-store.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "http_ece": "^1.2.1",
    "jsdom": "^30.0.1",
    "vite": "^5.4.8",
    "wrangler": "^4.20.0"
  }
}
