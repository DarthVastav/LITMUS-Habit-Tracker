# Build-time only. Vite compiles these into the browser bundle, so they are
# public by design — the anon key is safe because RLS does the real work.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
VITE_VAPID_PUBLIC_KEY=BJ...your-vapid-public-key

# The Worker's runtime values are NOT set here. They are encrypted secrets:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put VAPID_PUBLIC_KEY
#   npx wrangler secret put VAPID_PRIVATE_KEY
#   npx wrangler secret put VAPID_SUBJECT
#   npx wrangler secret put REMINDER_TEST_KEY
